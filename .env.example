# ---------------------------------------------------------------------------
# FocTrack configuration
#
# Backend values are read from backend/.env (prefix: FOCTRACK_).
# Frontend values are read from frontend/.env (prefix: VITE_).
# Never commit a real .env file.
# ---------------------------------------------------------------------------

# --- backend/.env ----------------------------------------------------------
# SQLite by default. Use an absolute path in production so the database lives
# on a persistent disk, e.g. sqlite:////var/data/focustrack.db
FOCTRACK_DATABASE_URL=sqlite:///./focustrack.db

# development | production
FOCTRACK_ENVIRONMENT=development

# Comma separated browser origins allowed to call the API.
FOCTRACK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Signs short-lived access tokens. Required in production: the app refuses to
# start unless this is at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FOCTRACK_JWT_SECRET=development-only-insecure-secret-change-me

# Google OAuth Web client id. Leave empty to hide Google sign-in and keep the
# password flow only. The same value goes in VITE_GOOGLE_CLIENT_ID.
FOCTRACK_GOOGLE_CLIENT_ID=

# Transactional email for password reset and address verification. Get a key
# from https://resend.com. Leave empty in development: links are written to the
# API log instead of being sent. Production returns 503 while it is empty.
FOCTRACK_RESEND_API_KEY=
# The sender. onboarding@resend.dev works for testing without a verified domain,
# but only delivers to the Resend account owner's address.
FOCTRACK_EMAIL_FROM=FocTrack <onboarding@resend.dev>
# Public frontend origin used to build the links inside those emails.
FOCTRACK_APP_URL=http://localhost:5173

# Only enable behind a trusted proxy (Render) that sets X-Forwarded-For.
FOCTRACK_TRUST_FORWARDED_FOR=false

# --- frontend/.env ---------------------------------------------------------
# API base path. In local development leave this as /api/v1 so Vite's proxy
# forwards requests (see VITE_PROXY_TARGET). In production point it at the
# deployed API origin, e.g. https://foctrack-api.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1

# Google OAuth Web client id. Leave empty to hide the Google button entirely.
VITE_GOOGLE_CLIENT_ID=

# Where the Vite dev server proxies /api during development. Change this if
# the API runs on a different port, or set it in frontend/.env.local.
VITE_PROXY_TARGET=http://127.0.0.1:8000
