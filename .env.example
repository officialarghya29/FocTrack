# ---------------------------------------------------------------------------
# FocTrack configuration
#
# Backend values are read from backend/.env (prefix: FOCTRACK_).
# Frontend values are read from frontend/.env (prefix: VITE_).
# Never commit a real .env file.
# ---------------------------------------------------------------------------

# --- backend/.env ----------------------------------------------------------
# SQLite by default. Use an absolute path in production so the database lives
# on a persistent disk, e.g. sqlite:////var/data/focustrack.db
FOCTRACK_DATABASE_URL=sqlite:///./focustrack.db

# development | production
FOCTRACK_ENVIRONMENT=development

# Comma separated browser origins allowed to call the API.
FOCTRACK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- frontend/.env ---------------------------------------------------------
# API base path. In local development leave this as /api/v1 so Vite's proxy
# forwards requests (see VITE_PROXY_TARGET). In production point it at the
# deployed API origin, e.g. https://foctrack-api.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies /api during development. Change this if
# the API runs on a different port, or set it in frontend/.env.local.
VITE_PROXY_TARGET=http://127.0.0.1:8000
